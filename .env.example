# Frontend Environment Variables

# API Configuration
# Development: http://localhost:5000
# Production: https://your-backend-domain.com
VITE_API_BASE_URL=https://echobackend-dexy.onrender.com

# AI Service API Keys
VITE_OPENROUTER_API_KEY=sk-or-v1-your-key-here
VITE_GROQ_API_KEY=gsk_your-key-here
VITE_YOUTUBE_API_KEY=AIzaSy_your-key-here

# Firebase Configuration (optional)
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Development Mode
# Set to true to enable admin panel button in sidebar
VITE_ENABLE_ADMIN_DEV=true
